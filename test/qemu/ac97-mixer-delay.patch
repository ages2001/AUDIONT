--- a/hw/audio/ac97.c
+++ b/hw/audio/ac97.c
@@ -24,6 +24,7 @@
 #include "hw/qdev-properties.h"
 #include "migration/vmstate.h"
 #include "qemu/module.h"
+#include "qemu/timer.h"
 #include "sysemu/dma.h"
 #include "qom/object.h"
 #include "ac97.h"
@@ -134,6 +135,10 @@
     int bup_flag;
     MemoryRegion io_nam;
     MemoryRegion io_nabm;
+    /* mixer-delay=ms: after a reset the mixer volume registers (0x02 - 0x1e) ignore writes
+       for that long (a codec whose analog side comes up late: CS4299 in a ThinkPad T23) */
+    uint32_t mixer_delay;
+    int64_t mixer_ready;
 };
 
 enum {
@@ -461,6 +466,7 @@
     uint8_t active[LAST_INDEX];
 
     dolog("mixer_reset\n");
+    s->mixer_ready = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + s->mixer_delay;
     memset(s->mixer_data, 0, sizeof(s->mixer_data));
     memset(active, 0, sizeof(active));
     mixer_store(s, AC97_Reset, 0x0000); /* 6940 */
@@ -544,6 +550,10 @@
     AC97LinkState *s = opaque;
 
     s->cas = 0;
+    if (s->mixer_delay && addr >= 0x02 && addr <= 0x1e &&
+        qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) < s->mixer_ready) {
+        return;                         /* the mixer is not up yet: the write is lost */
+    }
     switch (addr) {
     case AC97_Reset:
         mixer_reset(s);
@@ -1326,6 +1336,7 @@
 
 static Property ac97_properties[] = {
     DEFINE_AUDIO_PROPERTIES(AC97LinkState, card),
+    DEFINE_PROP_UINT32("mixer-delay", AC97LinkState, mixer_delay, 0),
     DEFINE_PROP_END_OF_LIST(),
 };
 
