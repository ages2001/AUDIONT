; AUDIONT - AC'97 / HD Audio / USB Audio sound driver for Windows 2000 and XP (x86, x64)
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%AUDIONT%
DriverVer=10/08/2026,1.0.0.0

[SourceDisksNames.x86]
1 = %Disk%,,,\i386
2 = %Disk%,,,\..\fw

[SourceDisksNames.amd64]
1 = %Disk%,,,\amd64
2 = %Disk%,,,\..\fw

[SourceDisksFiles]
audiont.sys = 1
;FWDISK (tools/mkdist.sh lists the audio DSP firmware here)

[DestinationDirs]
DefaultDestDir = 12
AUDIONT_Fw     = 12,audiont\fw

[Manufacturer]
%AUDIONT% = AUDIONT, NTamd64

[AUDIONT]
; Bay Trail / Cherry Trail / Broadwell audio DSPs in PCI mode
%LPE.Desc% = AUDIONT_Inst, PCI\VEN_8086&DEV_0F28
%LPE.Desc% = AUDIONT_Inst, PCI\VEN_8086&DEV_22A8
%LPE.Desc% = AUDIONT_Inst, PCI\VEN_8086&DEV_9CB6
; Intel controllers that may come up as an audio DSP (class 04 01 / 04 80, Smart Sound)
%HDA.Desc% = AUDIONT_Inst, PCI\VEN_8086&DEV_A170
%HDA.Desc% = AUDIONT_Inst, PCI\VEN_8086&DEV_9D70
