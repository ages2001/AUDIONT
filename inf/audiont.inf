[AUDIONT_Inst.NT]
CopyFiles = AUDIONT_Files, AUDIONT_Fw

[AUDIONT_Inst.NT.Services]
AddService = audiont, 0x00000002, AUDIONT_Service

[AUDIONT_Service]
DisplayName    = %SvcDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\audiont.sys
LoadOrderGroup = Extended Base
AddReg         = AUDIONT_Params

[AUDIONT_Params]
HKR,Parameters,StandardNames,0x00010003,0

[AUDIONT_Files]
audiont.sys

[AUDIONT_Fw]
;FWLIST

[Strings]
AUDIONT = "AUDIONT"
Disk = "AUDIONT disk"
SvcDesc = "AUDIONT sound driver"
HDA.Desc = "AUDIONT High Definition Audio"
AC97.Desc = "AUDIONT AC'97 Audio"
VIA.Desc = "AUDIONT VIA AC'97 Audio"
USB.Desc = "AUDIONT USB Audio (through USBNT)"
LPE.Desc = "AUDIONT Intel Audio DSP (Smart Sound)"
